{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "SG: Debug backend and open site",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "SG: Prepare debugging",
      "program": "${workspaceFolder}/backend/src/Sg.Api/bin/Debug/net10.0/Sg.Api.dll",
      "cwd": "${workspaceFolder}/backend/src/Sg.Api",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5080"
      },
      "console": "internalConsole",
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
        "uriFormat": "http://localhost:5173/projects"
      }
    }
  ]
}
